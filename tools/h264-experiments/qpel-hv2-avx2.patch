+%if ARCH_X86_64
+; Second separable half-pel pass, sixteen columns at once.
+%macro QPEL16_HV2_AVX2 1
+INIT_YMM avx2
+cglobal %1_h264_qpel16_hv2_lowpass, 3,4,6
+    mov          r3d, 16
+.loop:
+    movu         m0, [r1]
+    movu         m1, [r1+2]
+    movu         m2, [r1+4]
+    paddw        m0, [r1+10]
+    paddw        m1, [r1+8]
+    paddw        m2, [r1+6]
+    psubw        m0, m1
+    psraw        m0, 2
+    psubw        m0, m1
+    paddsw       m0, m2
+    psraw        m0, 2
+    paddw        m0, m2
+    psraw        m0, 6
+    vextracti128 xm1, m0, 1
+    packuswb     xm0, xm0, xm1
+%ifidn %1, avg
+    pavgb        xm0, xm0, [r0]
+%endif
+    mova         [r0], xm0
+    add          r1, 48
+    add          r0, r2
+    dec          r3d
+    jnz          .loop
+    RET
+%endmacro
+QPEL16_HV2_AVX2 put
+QPEL16_HV2_AVX2 avg
+%endif
